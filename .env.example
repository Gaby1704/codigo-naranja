# Copia este archivo a .env en la raíz del repositorio.
# La API lo lee al arrancar. No subas .env al repositorio.

APP_ENV=development

# Cuenta administradora. Se crea solo si el correo es válido y la
# contraseña tiene al menos 12 caracteres. Déjalas vacías si todavía
# no quieres habilitar la carga de archivos.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Orígenes permitidos cuando el navegador llama a la API directo.
# En desarrollo, Vite hace de proxy y este valor no interviene.
CORS_ORIGINS=http://localhost:5173

# true solo detrás de HTTPS. En local y en docker-compose por HTTP debe ser false.
COOKIE_SECURE=false

# true cuando Nginx envía X-Real-IP (el compose de este repo lo activa).
TRUST_PROXY=false

# Opcional. Si se omite, la base queda en apps/api/data/codigo_naranja.sqlite.
# DATABASE_PATH=
