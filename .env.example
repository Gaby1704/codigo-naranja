# Copia este archivo a .env en la raíz del repositorio (o configura estas variables en tu plataforma de despliegue).
# Nunca subas archivos .env con valores reales al repositorio.

# Entorno de ejecución: "development" (local) o "production" (despliegue).
APP_ENV=development

# Dirección y puerto de escucha del servidor API (por defecto 0.0.0.0:8000 en local).
HOST=0.0.0.0
PORT=8000

# Cadena de conexión a la base de datos.
# En producción con PostgreSQL/Neon usa: postgresql://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require
# Si usas Neon con -pooler, el backend omite automáticamente channel_binding en el pooler y desactiva prepared statements.
# Si se deja vacía en local, se utiliza SQLite mediante DATABASE_PATH.
DATABASE_URL=

# Opcional (recomendado en Neon si prefieres ejecutar la creación/migración de tablas sin pooler):
# URL directa (sin "-pooler") usada solo en el arranque para init_db().
DATABASE_DIRECT_URL=postgresql://neondb_owner:npg_wPcpuq0y5vtB@ep-quiet-sea-bbwkmf3r-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Modo SSL adicional para PostgreSQL si DATABASE_URL no incluye ?sslmode=...
# Valores habituales: require, verify-full, prefer. En producción con PostgreSQL se aplica "require" por defecto.
DATABASE_SSL_MODE=

# Ruta del archivo SQLite cuando no se utiliza DATABASE_URL (solo respaldo/entorno local).
# Si se omite, se crea en apps/api/data/codigo_naranja.sqlite.
# DATABASE_PATH=

# Correo inicial de la cuenta administradora (obligatorio en producción).
ADMIN_EMAIL=

# Contraseña inicial en texto plano (mínimo 12 caracteres, máximo 72 bytes).
# Alternativamente, puedes omitirla y usar ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=

# Hash bcrypt precalculado para la cuenta administradora (opcional, sustituye a ADMIN_PASSWORD).
# Ejemplo de generación: python -c "import bcrypt; print(bcrypt.hashpw(b'...', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=

# Clave secreta para firmar y validar tokens de sesión HMAC-SHA256.
# Obligatoria en producción (mínimo 32 caracteres aleatorios).
# Ejemplo de generación: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Lista separada por comas de orígenes permitidos por CORS (sin "*" cuando hay cookies con credenciales).
# En producción incluye la URL pública HTTPS del frontend (ej. https://tablero.dominio.mx).
CORS_ORIGINS=http://localhost:5173

# Seguridad de cookies de sesión:
# - COOKIE_SECURE: true detrás de HTTPS (por defecto true en production, false en development).
# - COOKIE_SAMESITE: "lax" (mismo dominio/sitio) o "none" (frontend y backend en dominios HTTPS distintos; exige COOKIE_SECURE=true).
# - COOKIE_DOMAIN: dominio opcional para compartir cookie entre subdominios.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# true cuando un proxy inverso confiable (Nginx, Cloudflare, Render, etc.) envía el encabezado X-Real-IP.
TRUST_PROXY=false

# URL base pública de la API para compilación del frontend cuando reside en otro dominio (opcional).
# Ejemplo en producción separada: https://api.dominio.mx
# VITE_API_BASE_URL=
