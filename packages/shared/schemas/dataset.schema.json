{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codigo-naranja.local/schemas/dataset.json",
  "title": "Dataset",
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone",
        "residenceZone",
        "period",
        "eventDate",
        "violence",
        "service",
        "cases",
        "capacity",
        "person",
        "periodStatus"
      ],
      "properties": {
        "zone": { "type": "string" },
        "residenceZone": { "type": "string" },
        "period": { "type": "string" },
        "eventDate": { "type": "string" },
        "violence": { "type": "string" },
        "service": { "type": "string" },
        "cases": { "type": "string" },
        "capacity": { "type": "string" },
        "person": { "type": "string" },
        "periodStatus": { "type": "string" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "name",
        "sheet",
        "sheets",
        "headers",
        "preview",
        "rowCount",
        "suggestedMapping",
        "detectedDimensions",
        "detectedMetrics"
      ],
      "properties": {
        "uploadId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "sheet": { "type": "string" },
        "sheets": { "type": "array", "items": { "type": "string" } },
        "headers": { "type": "array", "items": { "type": "string" } },
        "preview": { "type": "array", "items": { "type": "object", "additionalProperties": { "type": "string" } } },
        "rowCount": { "type": "integer", "minimum": 0 },
        "suggestedMapping": { "$ref": "#/$defs/mapping" },
        "detectedDimensions": { "type": "array", "items": { "type": "string" } },
        "detectedMetrics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet", "mapping"],
      "properties": {
        "sheet": { "type": "string", "minLength": 1 },
        "mapping": { "$ref": "#/$defs/mapping" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "period", "violence", "service", "cases", "capacity"],
      "properties": {
        "zone": { "type": "string" },
        "residenceZone": { "type": "string" },
        "period": { "type": "string" },
        "eventDate": { "type": "string" },
        "violence": { "type": "string" },
        "service": { "type": "string" },
        "cases": { "type": ["number", "null"], "minimum": 0 },
        "capacity": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
